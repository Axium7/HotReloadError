<MudDialog TitleClass="dlgTitle">
	<TitleContent>
		@MudDialog.Title
	</TitleContent>
	<DialogContent>
		<MudGrid Spacing="4">

			@* Works *@
			<MudItem xs="5">
				<MudField Variant=@Variant.Outlined
						  InnerPadding=@false
						  Label="Works">
					<MudCheckBox T=@bool
								 Size=@Size.Small
								 @bind-Value=@blnError
								 @bind-Value:after=@SaveRecord />  @* Removing this but keeping DialogActions also prevents the Error *@
				</MudField>
			</MudItem>

		</MudGrid>
	</DialogContent>

	@* NO DialogActions prevents the HotReload Error *@

</MudDialog>