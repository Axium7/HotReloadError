@page "/"
@inject IDialogService MudDialogs

<PageTitle>Give MudList Focus</PageTitle>

<MudGrid Spacing="2">

	<MudItem xs="2">

		<MudTextField @bind-Value=@strDummyField
					  Margin=@Margin.Dense
					  MaxLength="25"
					  Clearable=@true
					  Label="Dummy Field"
					  ShrinkLabel=@true
					  Variant=@Variant.Outlined />

	</MudItem>

	
	@* PO Num *@
	<MudItem xs="2">
		<MudAutocomplete T="string"
						 @bind-Value=@strUserInputPONum
						 SearchFunc=@SearchPONums
						 CoerceValue=@true
						 Margin=@Margin.Dense
						 MaxLength="25"
						 Clearable=@true
						 Label="PO Num"
						 ShrinkLabel=@true
						 Variant=@Variant.Outlined
						 Dense=@true
						 RelativeWidth="DropdownWidth.Adaptive">
			<ItemTemplate>
				@{ var schedule = lstScheduledPONums.First(s => s.PONum == context); }
				<MudStack Row="@true" Spacing="2">
					<MudText Typo="@Typo.body1" Style="font-weight:700; width:150px;">@schedule.PONum</MudText>

					@if (schedule.IsDrum)
					{
						<MudIcon Icon=@Icons.Material.Rounded.Check
								 Color="@Color.Dark"
								 Style="width:50px;" />
					}
					else
					{
						<div style="width:50px;"></div>
					}
					<MudText Typo="@Typo.body1" Style="width:125px;">@schedule.Status</MudText>
					<MudText Typo="@Typo.body1" Style="width:200px;">@schedule.BrokerName</MudText>
					<MudText Typo="@Typo.body1" Style="width:200px;">@schedule.CarrierName</MudText>
				</MudStack>
			</ItemTemplate>
		</MudAutocomplete>
	</MudItem>
</MudGrid>

@code {

	private string? strUserInputPONum;
	private string strDummyField;

	private Task<IEnumerable<string>> SearchPONums(string? strSearch, CancellationToken token)
	{
		IEnumerable<string> lstMatches = lstScheduledPONums
			.Select(s => s.PONum)
			.Where(poNum => string.IsNullOrWhiteSpace(strSearch) || poNum.Contains(strSearch, StringComparison.OrdinalIgnoreCase));

		return Task.FromResult(lstMatches);
	}

	public class ScheduledPONum
	{
		public string PONum { get; set; } = "";
		public bool IsDrum { get; set; }
		public string Status { get; set; } = "";
		public string BrokerName { get; set; } = "";
		public string CarrierName { get; set; } = "";
	}

	private List<ScheduledPONum> lstScheduledPONums = new()
	{
		new()
		{
			PONum = "PO-2026-1001",
			IsDrum = true,
			Status = "Pending",
			BrokerName = "Clean Harbors",
			CarrierName = "ABC Transport"
		},
		new()
		{
			PONum = "PO-2026-1002",
			IsDrum = false,
			Status = "Scheduled",
			BrokerName = "GFL Environmental",
			CarrierName = "TransX"
		},
		new()
		{
			PONum = "PO-2026-1003",
			IsDrum = true,
			Status = "Completed",
			BrokerName = "Waste Connections",
			CarrierName = "Day & Ross"
		},
		new()
		{
			PONum = "PO-2026-1004",
			IsDrum = true,
			Status = "In Transit",
			BrokerName = "Clean Harbors",
			CarrierName = "Manitoulin Transport"
		},
		new()
		{
			PONum = "PO-2026-1005",
			IsDrum = false,
			Status = "Pending",
			BrokerName = "GFL Environmental",
			CarrierName = "Challenger Motor Freight"
		}
	};
}

