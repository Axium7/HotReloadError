@page "/"
@inject IDialogService MudDialogs

<PageTitle>Give MudList Focus</PageTitle>

<MudGrid Spacing="2">

	<MudItem xs="2">

		<MudTextField @bind-Value=@strDummyField
					  Margin=@Margin.Dense
					  MaxLength="25"
					  Clearable=@true
					  Label="Dummy Field"
					  ShrinkLabel=@true
					  Variant=@Variant.Outlined />

	</MudItem>

	
	@* PO Num *@
	<MudItem xs="2">
		<div @onfocusout="@PONumFieldFocusOut">
			<MudTextField @ref=@refPONumField
						  @bind-Value=@strUserInputPONum
						  OnKeyDown=@PONumKeyDown
						  Margin=@Margin.Dense
						  MaxLength="25"
						  Clearable=@true
						  @onfocusin="@OpenMudListPONum"
						  Label="PO Num"
						  ShrinkLabel=@true
						  Variant=@Variant.Outlined />

			<MudPopover @bind-Open="@blnMudListOpenPONum"
						Elevation="25"
						TransformOrigin="Origin.TopCenter"
						Square="@false"
						Paper="@true"
						RelativeWidth="DropdownWidth.Adaptive"
						AnchorOrigin="Origin.BottomCenter">

				<div @ref=@refPONumListContainer
					 @onfocusin="@PONumListFocusIn"
					 @onfocusout="@PONumListFocusOut"
					 @onkeydown="@PONumListKeyDown">
				<MudList @ref=@refMudListPONum
						 T="string"
						 SelectionMode="@SelectionMode.SingleSelection"
						 SelectedValue="@strPONumMudSelect"
						 SelectedValueChanged="@SetPONum"
						 Dense="@true"
						 Style="max-height: 400px; overflow-y: auto; border: solid 1px black; border-radius: 8px; margin-left: 8px; margin-top: 0px;">

					@foreach (var schedule in lstScheduledPONums)
					{
						<MudListItem Value="@schedule.PONum" OnClick="@CommitPONum">
							<MudStack Row="@true" Spacing="2">
								<MudText Typo="@Typo.body1" Style="font-weight:700; width:150px; margin-left: -8px;">@schedule.PONum</MudText>

								@if (schedule.IsDrum)
								{
									<MudIcon Icon=@Icons.Material.Rounded.Check
											 Color="@Color.Dark"
											 Style="width:50px;" />
								}
								else
								{
									<div style="width:50px;"></div>
								}
								<MudText Typo="@Typo.body1" Style="width:125px;">@schedule.Status</MudText>
								<MudText Typo="@Typo.body1" Style="width:200px;">@schedule.BrokerName</MudText>
								<MudText Typo="@Typo.body1" Style="width:200px;">@schedule.CarrierName</MudText>
							</MudStack>
						</MudListItem>
					}

				</MudList>
				</div>
			</MudPopover>
		</div>
	</MudItem>
</MudGrid>

@code {

	private MudList<string> refMudListPONum;
	private bool blnMudListOpenPONum;
	private string? strUserInputPONum;
	private string? strPONumMudSelect;
	private string strDummyField;
	private MudTextField<string>? refPONumField;
	private ElementReference refPONumListContainer;
	private bool blnPONumFieldHasFocus;
	private bool blnPONumListHasFocus;
	private bool blnFocusPONumListOnRender;
	private bool blnSkipOpenPONum;
	private string? strPONumBeforeList;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!blnFocusPONumListOnRender)
			return;

		blnFocusPONumListOnRender = false;
		await refPONumListContainer.MudFocusFirstAsync();
	}

	private void OpenMudListPONum()
	{
		blnPONumFieldHasFocus = true;

		if (blnSkipOpenPONum)
		{
			blnSkipOpenPONum = false;
			return;
		}

		blnMudListOpenPONum = true;
	}

	private async Task PONumFieldFocusOut()
	{
		blnPONumFieldHasFocus = false;
		await CloseMudListPONum();
	}

	private void PONumListFocusIn()
	{
		blnPONumListHasFocus = true;
	}

	private async Task PONumListFocusOut()
	{
		blnPONumListHasFocus = false;
		await CloseMudListPONum();
	}

	private async Task CloseMudListPONum()
	{
		await Task.Delay(150);

		// Focus moved between the field and the list, so keep the list open
		if (blnPONumFieldHasFocus || blnPONumListHasFocus)
			return;

		HideMudListPONum();
	}

	private void HideMudListPONum()
	{
		blnMudListOpenPONum = false;
		strPONumMudSelect = null;
	}

	private void PONumKeyDown(KeyboardEventArgs args)
	{
		if (args.Key != "ArrowDown" || lstScheduledPONums.Count == 0)
			return;

		// The list renders in the popover provider, so focus its first item after render
		strPONumBeforeList = strUserInputPONum;
		blnMudListOpenPONum = true;
		blnFocusPONumListOnRender = true;
	}

	private async Task PONumListKeyDown(KeyboardEventArgs args)
	{
		if (args.Key != "Escape")
			return;

		// Selection follows focus in the list, so Escape restores the value from before ArrowDown
		strUserInputPONum = strPONumBeforeList;
		HideMudListPONum();
		await FocusPONumField();
	}

	private async Task SetPONum(string? strValue)
	{
		strPONumMudSelect = strValue;
		strUserInputPONum = strPONumMudSelect;
	}

	// Click, Enter and Space commit the item the list has already selected
	private async Task CommitPONum()
	{
		HideMudListPONum();
		await FocusPONumField();
	}

	private async Task FocusPONumField()
	{
		if (refPONumField is null)
			return;

		// Return focus without reopening the list
		blnSkipOpenPONum = true;
		await refPONumField.FocusAsync();
	}

	public class ScheduledPONum
	{
		public string PONum { get; set; } = "";
		public bool IsDrum { get; set; }
		public string Status { get; set; } = "";
		public string BrokerName { get; set; } = "";
		public string CarrierName { get; set; } = "";
	}

	private List<ScheduledPONum> lstScheduledPONums = new()
	{
		new()
		{
			PONum = "PO-2026-1001",
			IsDrum = true,
			Status = "Pending",
			BrokerName = "Clean Harbors",
			CarrierName = "ABC Transport"
		},
		new()
		{
			PONum = "PO-2026-1002",
			IsDrum = false,
			Status = "Scheduled",
			BrokerName = "GFL Environmental",
			CarrierName = "TransX"
		},
		new()
		{
			PONum = "PO-2026-1003",
			IsDrum = true,
			Status = "Completed",
			BrokerName = "Waste Connections",
			CarrierName = "Day & Ross"
		},
		new()
		{
			PONum = "PO-2026-1004",
			IsDrum = true,
			Status = "In Transit",
			BrokerName = "Clean Harbors",
			CarrierName = "Manitoulin Transport"
		},
		new()
		{
			PONum = "PO-2026-1005",
			IsDrum = false,
			Status = "Pending",
			BrokerName = "GFL Environmental",
			CarrierName = "Challenger Motor Freight"
		}
	};
}

<style>
	/*Overwriting the MudBlazor .mud-header class*/
	.mud-header {
		color: #FFFFFF !important;
		border: thin solid black !important;
		border-radius: 0 !important;
		background-color: var(--mud-palette-primary) !important;
	}
</style>