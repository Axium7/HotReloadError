@page "/"
@inject IDialogService MudDialogs

<PageTitle>Hot Reload Error</PageTitle>

<MudGrid Spacing="4">

	<MudButton Variant=@Variant.Filled
			   Color=@Color.Primary
			   OnClick=@OpenDialogError>
		Open Dialog Error
	</MudButton>

	<MudButton Variant=@Variant.Filled
			   Color=@Color.Primary
			   OnClick=@OpenDialogWorks>
		Open Dialog Works
	</MudButton>


</MudGrid>

@code {

	private async Task OpenDialogError()
	{
		DialogOptions options = new()
		{
			CloseButton = true,
			MaxWidth = MaxWidth.Small,
			FullWidth = true
		};

		await MudDialogs.ShowAsync<DlgMudCheckBoxError>("Hot Reload Test", options);
	}

	private async Task OpenDialogError()
	{
		DialogOptions options = new()
		{
			CloseButton = true,
			MaxWidth = MaxWidth.Small,
			FullWidth = true
		};

		await MudDialogs.ShowAsync<DlgMudCheckBoxError>("Hot Reload Test", options);
	}
}

