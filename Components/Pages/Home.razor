@page "/"
@inject IDialogService MudDialogs

<PageTitle>Hot Reload Error</PageTitle>

<MudGrid Spacing="4">

	<MudItem xs="3">
		<MudButton Variant=@Variant.Filled
				   Color=@Color.Primary
				   OnClick=@OpenDialogError>
			Open Dialog Error
		</MudButton>
	</MudItem>

	<MudItem xs="3">
		<MudButton Variant=@Variant.Filled
				   Color=@Color.Primary
				   OnClick=@OpenDialogWorks>
			Open Dialog Works
		</MudButton>
	</MudItem>

</MudGrid>

@code {

	private async Task OpenDialogError()
	{
		DialogOptions options = new()
		{
			CloseButton = true,
			MaxWidth = MaxWidth.Small,
			FullWidth = true
		};

		await MudDialogs.ShowAsync<DlgMudCheckBoxError>("Hot Reload Error: Change xs=\"\" to generate Error", options);
	}

	private async Task OpenDialogWorks()
	{
		DialogOptions options = new()
		{
			CloseButton = true,
			MaxWidth = MaxWidth.Small,
			FullWidth = true
		};

		await MudDialogs.ShowAsync<DlgMudCheckBoxWorks>("Hot Reload Works", options);
	}
}

