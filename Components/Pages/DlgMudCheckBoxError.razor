<MudDialog TitleClass="dlgTitle">
	<TitleContent>
		@MudDialog.Title
	</TitleContent>
	<DialogContent>
		<MudGrid Spacing="4">

			@* Error *@
			<MudItem xs="4">
				<MudField Variant=@Variant.Outlined
						  InnerPadding=@false
						  Label="Error">
					<MudCheckBox T=@bool
								 Size=@Size.Small
								 @bind-Value=@blnError
								 @bind-Value:after=@SaveRecord /> @* Removing @bind-Value:after=@SaveRecord prevents the error *@
				</MudField>
			</MudItem>

		</MudGrid>
	</DialogContent>
	<DialogActions>
		@* Removing DialogActions prevents the Error *@
	</DialogActions>
</MudDialog>