<MudDialog TitleClass="dlgTitle">
	<TitleContent>
		@MudDialog.Title
	</TitleContent>
	<DialogContent>
		<MudGrid Spacing="4">
			
			@* Error *@
			<MudItem xs="6">
				<MudField Variant=@Variant.Outlined
						  InnerPadding=@false
						  Label="Error">
					<MudCheckBox T=@bool
								 Size=@Size.Small
								 @bind-Value=@blnError
								 @bind-Value:after=@SaveRecord />
				</MudField>
			</MudItem>

		</MudGrid>
	</DialogContent>
	<DialogActions>

		@* Save *@
		<MudIconButton OnClick=@(() => MudDialog?.Close()) AutoFocus=@true
					   Size=@Size.Large
					   Style="width: 7%"
					   Icon=@Icons.Material.Rounded.CheckCircle
					   Color=@Color.Info
					   Variant=@Variant.Filled />

	</DialogActions>
</MudDialog>